# =============================================
# MySpace - Root .gitignore
# =============================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Production builds
dist/
build/
target/
out/

# Environment files (NEVER commit secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
hs_err_pid*

# Editor directories and files
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store

# Java/Maven
*.class
*.jar
*.war
*.ear
*.log
.mtj.tmp/
hs_err_pid*

# Testing
coverage/
.nyc_output/

# OS
Thumbs.db
.DS_Store

# Temporary files
*.tmp
*.temp
.cache/

# Docker
.dockerignore

# Local development
docker-compose.override.yml
