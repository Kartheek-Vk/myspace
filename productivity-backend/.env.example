# =============================================
# MySpace Backend Environment Variables
# =============================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# =============================================

# =============================================
# Google OAuth (REQUIRED)
# =============================================
# Get from: https://console.cloud.google.com/apis/credentials
# Create OAuth 2.0 Client ID -> Web application
# Add authorized JavaScript origins: http://localhost:5173
# Add authorized redirect URIs: http://localhost:8080/api/auth/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# =============================================
# JWT Authentication (REQUIRED)
# =============================================
# Generate a secure random secret (at least 64 characters for HS512)
# Use: openssl rand -base64 64
# Or: https://www.random.org/strings/?num=1&len=80&digits=on&upperalpha=on&loweralpha=on&unique=on
JWT_SECRET=your-64-character-or-longer-secret-key-here-change-this-in-production

# Token expiration in milliseconds (default: 7 days = 604800000)
JWT_EXPIRATION_MS=604800000

# =============================================
# Database - PostgreSQL (REQUIRED)
# =============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=productivity_db
DB_USERNAME=postgres
DB_PASSWORD=your-secure-password-here

# Connection pool size (default: 10)
DB_POOL_SIZE=10

# =============================================
# JPA / Hibernate
# =============================================
# Options: none, validate, update, create, create-drop
# Use 'validate' in production after migrations are applied
JPA_DDL_AUTO=update

# =============================================
# Flyway Database Migrations
# =============================================
# Enable Flyway for production migrations
FLYWAY_ENABLED=false

# =============================================
# CORS (REQUIRED)
# =============================================
# Frontend URL(s) allowed to make requests
# For production: https://your-domain.vercel.app
FRONTEND_URL=http://localhost:5173

# =============================================
# Email Configuration (OPTIONAL)
# =============================================
# Enable email notifications
MAIL_ENABLED=false

# SMTP server settings
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password-here
MAIL_FROM=noreply@myspace.app

# =============================================
# Server Port
# =============================================
# Default: 8080
PORT=8080
